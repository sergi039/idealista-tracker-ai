# ==============================================
# Idealista Tracker AI - Environment Config
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Docker isolation (only set these in a second checkout) ---
#
# Container names, the network and the data volume are global Docker resources,
# so two checkouts running `docker compose up` collide: the second one steals
# the name `idealista-app` from production and blocks the deploy watcher.
# Leave all three UNSET in the main checkout - the defaults are the production
# names and ports (idealista-app / idealista-db, 5001, 5434). In a worktree or
# branch build, set them to something unique:
#
# COMPOSE_CONTAINER_PREFIX=wt1     # -> wt1-app, wt1-db, wt1-network, wt1-universal-pgdata
# APP_HOST_PORT=5101               # host port for the app (container stays 5001)
# DB_HOST_PORT=5534                # host port for postgres debugging

# --- Required ---

# Flask session security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=

# Browser cookie isolation (recommended when running legacy + universal on localhost)
SESSION_COOKIE_NAME=idealista_universal_session

# Database (used by docker-compose)
DB_NAME=idealista_universal
DB_USER=idealista
DB_PASSWORD=

# --- Email Ingestion (Required for data import) ---

# Gmail IMAP credentials
# Get App Password: https://myaccount.google.com/apppasswords
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=

# Email settings (defaults work for Gmail)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=true
# For Gmail, this is interpreted as a Gmail label (used in X-GM-RAW search).
# Recommended to keep it separate from the legacy app label.
IMAP_FOLDER=IdealistaProperties
# Fotocasa alert senders for the same Gmail search, comma-separated. The
# default (the bare domain) matches any mailbox under fotocasa.es; narrow it
# to the real sender once an alert email is in the mailbox. Empty disables
# fotocasa email ingestion. The Gmail filter must also put the IMAP_FOLDER
# label on fotocasa alert mail, or it is never fetched at all.
#FOTOCASA_ALERT_SENDERS=fotocasa.es

# --- Optional: Google APIs (for enrichment) ---

# Google Maps/Places API keys
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Optional: AI Analysis ---

# Anthropic API key (for AI property analysis)
ANTHROPIC_API_KEY=

# Optional: override Anthropic model (default: claude-sonnet-5)
ANTHROPIC_MODEL=

# OpenAI API key (for ChatGPT comparison)
OPENAI_API_KEY=

# Optional: override OpenAI model (default: gpt-5.6-terra). Must be an id the
# codex CLI knows; anything else is ignored and the CLI default is used.
OPENAI_MODEL=

# --- Optional: Admin access ---

# Admin token required for settings + admin endpoints
ADMIN_API_TOKEN=

# --- Dev Mode ---

# Set to true for development (enables debug logs, some dev conveniences)
DEV_MODE=false

# --- Feature flags ---

# Scheduled IMAP ingestion is a production-critical subsystem. Disabling it
# intentionally makes /api/healthz return 503.
#
# The default is false, and that is the whole point: exactly ONE machine may
# ingest. Two machines polling the same mailbox is not a duplicate of the same
# work, it is two divergent databases plus a second Google bill for every
# listing (#376). Whichever machine is the deployment sets this to true in its
# own .env - here it stays off, so a fresh clone, a worktree, or a dev checkout
# copying this file cannot become a second ingester by inheriting a default
# nobody chose.
AUTO_START_SCHEDULER=false

# Select ingestion pipeline: 'properties' (new universal) or 'lands' (legacy)
INGESTION_TARGET=properties

# Sale-only ingestion (skip rentals unless you disable this)
SALE_ONLY=true

# Optional: skip categories entirely during ingestion (comma-separated).
# Example: keep legacy land tracker separate by skipping land here.
EXCLUDED_PROPERTY_CATEGORIES=land

# Automatically compute travel times after ingestion (Google Places + Distance
# Matrix, about $0.36 per listing). OFF since 2026-08-17: this was the only
# automatic paid caller in the app, and with the scheduler running on two
# machines against one mailbox it billed every listing twice. Travel is
# measured on request now -- the Enrich button on /properties/<id>, or
# `utils/recalc_property_travel.py`. Turning it back on bills every newly
# ingested listing, twice a day, unattended.
AUTO_TRAVEL_ENRICHMENT=false

# Geocode newly ingested listings (Google Geocoding, ~$0.005 per listing).
# Deliberately still on: without a coordinate the free enrichers -- sea
# distance, sea-view verdict, OSM amenities, quality of life -- have nothing
# to measure and the score is computed from almost nothing. Set to false only
# for a machine that must reach no Google API at all.
AUTO_GEOCODING=true

# May this machine reach a billed Google API at all? The inner gate is
# utils/google_spend: no billed request is made outside an authorization
# somebody opened on purpose (a pressed Enrich button, a CLI run with
# --reason), and the default is no authorization. THIS flag is the outer lock,
# for a machine that must never spend whatever its code does -- a dev
# checkout, a git worktree, a throwaway clone. Set it to false there.
# It defaults to true so that a deploy of the gate cannot stop the
# deployment's own Enrich button (the AUTO_START_SCHEDULER mistake).
GOOGLE_SPEND_ENABLED=true

# Automatically compute Property scoring after ingestion (local DB only)
AUTO_PROPERTY_SCORING=true
